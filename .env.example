# PostgreSQL database connection
DATABASE_URL=""
DIRECT_URL=""

# Supabase project and server-side Storage access. Never expose the secret key as NEXT_PUBLIC_*.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# JWT auth secret
JWT_SECRET="replace_with_a_secure_random_value"

# Optional public origin for authentication redirects behind a reverse proxy or tunnel.
# Leave unset to use the incoming request origin (for example, http://localhost:3000).
# AUTH_BASE_URL="https://your-public-hostname"

# Payment config. Keep demo until M-Pesa credentials and a public HTTPS callback are configured.
PAYMENT_MODE="demo"
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
MPESA_CALLBACK_URL=""
STRIPE_SECRET=""
PAYPAL_CLIENT_ID=""

# Admin initial email
ADMIN_EMAIL="admin@example.com"
# Required only when the seed script creates the initial admin; use a unique random password of at least 16 characters.
ADMIN_PASSWORD=""
